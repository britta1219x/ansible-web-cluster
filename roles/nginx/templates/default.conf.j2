# lb 节点（node1 / node2）站点配置：VIP 当前落在哪台，就由哪台响应
server {
    listen       80 default_server;
    server_name  _;

    root   /var/www/html;
    index  index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok from {{ inventory_hostname }}\n";
    }
}
