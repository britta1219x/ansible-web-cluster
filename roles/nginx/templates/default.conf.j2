upstream backend {
    least_conn;
    server {{ hostvars['node1']['ansible_host'] }}:80;
    server {{ hostvars['node2']['ansible_host'] }}:80;
    server {{ hostvars['node3']['ansible_host'] }}:80;
}

server {
    listen 80;
    server_name _;

    root /var/www/html;
    index index.html;

    location / {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /status {
        stub_status on;
        access_log off;
    }
}
