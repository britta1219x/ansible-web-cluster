! Configuration File for keepalived

global_defs {
    router_id {{ inventory_hostname }}
    vrrp_skip_check_adv_addr
    vrrp_garp_master_delay 1
}

vrrp_instance VI_1 {
    state {{ keepalived_state | default('BACKUP') }}
    interface {{ interface | default('ens160') }}
    virtual_router_id 51
    priority {{ keepalived_priority | default(90) }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass 1111
    }
    virtual_ipaddress {
        {{ vip }} dev {{ interface | default('ens160') }}
    }
}
